# Hugging Face Access Token (Required for DeepSeek generation and HF Inference API)
# Get your free token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Generation LLM Model (DeepSeek V3, DeepSeek R1, Llama 3, etc.)
LLM_MODEL=deepseek-ai/DeepSeek-V3-0324

# Embedding Model (sentence-transformers/all-MiniLM-L6-v2)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Embedding Provider: "auto", "local", or "hf_api"
EMBEDDING_PROVIDER=auto

# RAG Hyperparameters
DEFAULT_CHUNK_SIZE=300
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_K=5
SIMILARITY_THRESHOLD=0.40
TEMPERATURE=0.2

# Host and Port
PORT=8000
HOST=0.0.0.0
