# Groq API Key (Get free key at: https://console.groq.com/keys)
GROQ_API_KEY=

# Admin Password (To add permanent database files)
ADMIN_PASSWORD=your_admin_password_here

# Optional: GitHub Direct Sync
# When set, any file you upload with your admin password in the web UI
# is committed directly to your GitHub repository at backend/data/corpus/
GITHUB_TOKEN=
GITHUB_REPO=Masood-Haider/rag-project
GITHUB_BRANCH=main
