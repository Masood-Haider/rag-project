# ==========================================
# LLM Provider Configuration
# Options: "groq" (Recommended, ultra-fast & free tier) or "huggingface"
# ==========================================
LLM_PROVIDER=groq

# ------------------------------------------
# Groq API Configuration (FREE Tier Models)
# Free API key at: https://console.groq.com/keys
# Recommended free models:
# - llama-3.3-70b-versatile (Powerful & completely free on Groq)
# - llama-3.1-8b-instant (Fastest & free)
# - deepseek-r1-distill-llama-70b (Free DeepSeek reasoning on Groq)
# ------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ------------------------------------------
# Hugging Face Access Token (Optional alternative)
# ------------------------------------------
HF_TOKEN=
LLM_MODEL=deepseek-ai/DeepSeek-V3-0324

# ------------------------------------------
# Embedding Configuration
# ------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_PROVIDER=auto

# ------------------------------------------
# RAG Hyperparameters
# ------------------------------------------
DEFAULT_CHUNK_SIZE=300
DEFAULT_CHUNK_OVERLAP=50
DEFAULT_K=5
SIMILARITY_THRESHOLD=0.40
TEMPERATURE=0.2

# Host and Port
PORT=8000
HOST=0.0.0.0
